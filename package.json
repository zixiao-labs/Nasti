{
  "name": "@nasti-toolchain/nasti",
  "version": "2.5.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "娜斯提-基于Rolldown的统一Web打包工具（没错，明日方舟干员命名）",
  "keywords": [
    "rolldown",
    "arknights",
    "webpack-alternative",
    "vite-alternative"
  ],
  "homepage": "https://github.com/zixiao-labs/Nasti#readme",
  "bugs": {
    "url": "https://github.com/zixiao-labs/Nasti/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixiao-labs/Nasti.git"
  },
  "license": "MIT",
  "author": "amiya167",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || >=24.11.0",
      "onFail": "warn"
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "import": "./dist/client/hmr.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nasti": "bin/nasti.js"
  },
  "files": [
    "dist",
    "bin",
    "client"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "pnpm build && pnpm test:run",
    "test:run": "node --test"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "chokidar": "^4.0.0",
    "connect": "^3.7.0",
    "dotenv": "^16.4.0",
    "import-meta-resolve": "^4.2.0",
    "oxc-parser": "^0.142.0",
    "oxc-transform": "^0.142.0",
    "picocolors": "^1.1.0",
    "react-refresh": "^0.14.2",
    "rolldown": "1.2.1",
    "sirv": "^3.0.0",
    "source-map-js": "^1.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/oxide": "^4.3.0",
    "@types/connect": "^3.4.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "oxc-transform-react": "^0.142.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0",
    "vue": "^3.6.0-rc.2"
  },
  "optionalDependencies": {
    "@vue/compiler-sfc": "^3.6.0-rc.2",
    "lightningcss": "^1.32.0"
  },
  "peerDependencies": {
    "oxc-transform-react": "^0.142.0",
    "react-server-dom-webpack": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "oxc-transform-react": {
      "optional": true
    },
    "react-server-dom-webpack": {
      "optional": true
    }
  }
}
